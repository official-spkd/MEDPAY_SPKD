# ── Aplikasi ──────────────────────────────────────────────
# development | production
APP_ENV=development
APP_PORT=8080
# Pisahkan dengan koma jika lebih dari satu origin
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Database PostgreSQL (wajib) ───────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta
