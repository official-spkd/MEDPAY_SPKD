# ── Aplikasi ──────────────────────────────────────────────
# development | production
APP_ENV=development
APP_PORT=8080
# true = isi data & akun demo saat DB kosong. DILARANG true di produksi.
SEED_DEMO=true
# Alamat frontend; pisahkan dengan koma jika lebih dari satu origin
CORS_ORIGIN=http://localhost:5173
# IP reverse proxy (mis. Nginx). Kosongkan bila tidak ada.
TRUSTED_PROXIES=

# Super Admin pertama untuk instalasi tanpa data demo (dipakai sekali bila tabel users kosong).
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=

# ── Keamanan ──────────────────────────────────────────────
# Wajib di produksi, minimal 32 karakter. Contoh membuat: openssl rand -base64 48
JWT_SECRET=
# Sesi berakhir setelah tidak ada aktivitas (menit). 0 = nonaktif.
SESSION_IDLE_MINUTES=30
# Kode MFA langkah kedua (hanya non-produksi).
MFA_DEMO_CODE=246810

# ── Tugas otomatis antrean kerja ──────────────────────────
# Interval pemindaian (menit) untuk blocker, deadline kritis, piutang > 90 hari. 0 = nonaktif.
AUTO_TASKS_INTERVAL_MIN=60

# ── Database PostgreSQL (wajib) ───────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta
